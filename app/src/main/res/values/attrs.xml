<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Attributes for AppButton component -->
    <declare-styleable name="AppButton">
        <attr name="btnVariant" format="enum">
            <enum name="primary" value="0" />
            <enum name="secondary" value="1" />
            <enum name="success" value="2" />
            <enum name="ghost" value="3" />
        </attr>
        <attr name="btnCornerRadius" format="dimension" />
    </declare-styleable>

    <!-- Attributes for BaseView component -->
    <declare-styleable name="BaseView">
        <attr name="headerTitle" format="string" />
        <attr name="badgeText" format="string" />
        <attr name="showNavigationRail" format="boolean" />
    </declare-styleable>
</resources>
