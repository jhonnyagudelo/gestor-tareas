<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●  Botones" android:textStyle="bold" android:textSize="20sp" />
    <EditText android:id="@+id/etTituloTarea" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp" android:hint="Título de la tarea" android:inputType="textCapSentences" />
    <RadioGroup android:id="@+id/rgEstado" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <RadioButton android:id="@+id/rbActivo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ACTIVO" android:checked="true" />
        <RadioButton android:id="@+id/rbPausado" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PAUSADO" />
        <RadioButton android:id="@+id/rbArchivado" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ARCHIVADO" />
    </RadioGroup>
    <Button android:id="@+id/btnNuevaTarea" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nueva tarea" />
    <Button android:id="@+id/btnDuplicar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Duplicar" />
    <Button android:id="@+id/btnDescartar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Descartar" />
    <TextView android:id="@+id/tvResultado" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:padding="14dp" android:background="@drawable/bg_card" android:text="Escribe aquí una tarea y selecciona su estado." />
</LinearLayout></ScrollView>
